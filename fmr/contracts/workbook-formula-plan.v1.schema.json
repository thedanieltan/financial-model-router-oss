{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thedanieltan/financial-model-router-oss/blob/main/fmr/providers/native_xlsx/contracts/workbook-formula-plan.v1.schema.json",
  "title": "FMR workbook formula plan v1",
  "type": "object",
  "required": ["contract_version", "plan_type", "source", "semantic_map_sha256", "target_sheet", "periods", "records", "unresolved", "validation_checks", "controls", "ready_for_write", "blockers", "plan_id"],
  "properties": {
    "contract_version": {"const": "workbook-formula-plan.v1"},
    "plan_type": {"const": "monthly_fpa_formula_extension"},
    "source": {"type": "object", "required": ["filename", "sha256", "size_bytes"], "properties": {"filename": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "size_bytes": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "semantic_map_sha256": {"$ref": "#/$defs/sha256"},
    "target_sheet": {"type": ["string", "null"]},
    "periods": {"type": "array", "items": {"$ref": "#/$defs/period"}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "validation_checks": {"type": "array", "items": {"type": "string", "pattern": "^fmr\\.validation\\.[a-z0-9_]+\\.v1$"}, "uniqueItems": true},
    "controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "ready_for_write": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "plan_id": {"type": "string", "pattern": "^fmrfp_[0-9a-f]{24}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "period": {"type": "object", "required": ["coordinate", "column", "label", "kind"], "properties": {"coordinate": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"}, "column": {"type": "integer", "minimum": 1}, "label": {"type": "string", "minLength": 1}, "kind": {"enum": ["actual", "budget", "forecast", "unspecified"]}}, "additionalProperties": false},
    "record": {"type": "object", "required": ["sequence", "record_id", "target", "formula_specification", "bindings", "validation_checks"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "record_id": {"type": "string", "pattern": "^fmrf_[0-9]{6}$"}, "target": {"type": "object", "required": ["sheet", "cell", "metric", "period_label"], "properties": {"sheet": {"type": "string", "minLength": 1}, "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"}, "metric": {"type": "string", "minLength": 1}, "period_label": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "formula_specification": {"type": "object", "required": ["identifier", "specification_ref", "expression_language", "fill_policy"], "properties": {"identifier": {"const": "fmr.formula.forecast_column_copy.v1"}, "specification_ref": {"type": "string", "minLength": 1}, "expression_language": {"const": "fmr-expression.v1"}, "fill_policy": {"const": "down_target_range"}}, "additionalProperties": false}, "bindings": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["name", "source_type", "source"], "properties": {"name": {"const": "previous_period_formula"}, "source_type": {"enum": ["workbook_formula_cell", "planned_formula_cell"]}, "source": {"type": "object", "required": ["sheet", "cell", "period_label"], "properties": {"sheet": {"type": "string", "minLength": 1}, "cell": {"type": "string", "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"}, "period_label": {"type": "string", "minLength": 1}}, "additionalProperties": false}}, "additionalProperties": false}}, "validation_checks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}, "additionalProperties": false},
    "unresolved": {"type": "object", "required": ["sheet", "metric", "period_label", "target_cell", "reason"], "properties": {"sheet": {"type": "string", "minLength": 1}, "metric": {"type": "string", "minLength": 1}, "period_label": {"type": "string", "minLength": 1}, "target_cell": {"type": ["string", "null"], "pattern": "^[A-Z]{1,3}[1-9][0-9]*$"}, "reason": {"enum": ["forecast_cell_not_mapped", "no_preceding_period", "preceding_period_cell_not_mapped", "preceding_period_is_not_formula"]}}, "additionalProperties": false}
  }
}
