{
  "contract_version": "analyst-workflow-method.v1",
  "method_id": "operating-company-dcf-analyst-method",
  "version": "1.0.0",
  "family_id": "operating_company_dcf",
  "title": "Operating-company DCF analyst method",
  "objective": "Convert a supported operating forecast and explicit valuation assumptions into checked enterprise and equity value outputs, sensitivities and commentary-ready valuation evidence.",
  "steps": [
    {"step_id":"define-valuation-scope","sequence":1,"stage":"scope_decision","purpose":"Define the valuation subject, valuation date, currency, purpose and required outputs.","execution_class":"judgment","requirement_class":"universal","inputs":[],"outputs":["valuation_scope"],"checks":["valuation_basis_explicit"],"conditions":[],"source_references":["damodaran-valuation-class","icaew-financial-modelling-code"]},
    {"step_id":"load-operating-forecast-and-bridge-data","sequence":2,"stage":"source_history","purpose":"Load the supported operating forecast plus net debt, share-count and other required bridge data from governed sources.","execution_class":"source","requirement_class":"universal","inputs":["supported_operating_forecast","net_debt"],"outputs":["valuation_inputs"],"checks":["forecast_identity_verified","valuation_date_aligned"],"conditions":[],"source_references":["damodaran-valuation-class"]},
    {"step_id":"normalize-valuation-inputs","sequence":3,"stage":"normalize_reconcile","purpose":"Align periods, units, currency and bridge items and verify the forecast can support the selected DCF basis.","execution_class":"deterministic","requirement_class":"universal","inputs":["valuation_inputs"],"outputs":["normalized_valuation_inputs"],"checks":["periods_aligned","units_consistent"],"conditions":[],"source_references":["fast-standard-02c","icaew-financial-modelling-code"]},
    {"step_id":"set-valuation-assumptions","sequence":4,"stage":"assumptions_drivers","purpose":"Set explicit discount-rate and terminal-value assumptions and record their source or judgment basis.","execution_class":"judgment","requirement_class":"universal","inputs":["normalized_valuation_inputs"],"outputs":["valuation_assumptions"],"checks":["discount_rate_explicit","terminal_assumption_explicit"],"conditions":[],"source_references":["damodaran-valuation-class","fast-standard-02c"]},
    {"step_id":"derive-free-cash-flow","sequence":5,"stage":"supporting_schedules","purpose":"Derive the selected unlevered cash-flow series from the supported operating forecast using a consistent valuation basis.","execution_class":"deterministic","requirement_class":"universal","inputs":["normalized_valuation_inputs"],"outputs":["free_cash_flow_series"],"checks":["cash_flow_bridge_reconciles"],"conditions":[],"source_references":["damodaran-valuation-class"]},
    {"step_id":"calculate-present-value","sequence":6,"stage":"core_model","purpose":"Discount forecast cash flows and calculate terminal value under the selected explicit method.","execution_class":"deterministic","requirement_class":"universal","inputs":["free_cash_flow_series","valuation_assumptions"],"outputs":["enterprise_value_components"],"checks":["discount_periods_consistent"],"conditions":[],"source_references":["damodaran-valuation-class"]},
    {"step_id":"bridge-enterprise-to-equity","sequence":7,"stage":"core_model","purpose":"Bridge enterprise value to equity value using governed balance-sheet and financing adjustments.","execution_class":"deterministic","requirement_class":"universal","inputs":["enterprise_value_components","normalized_valuation_inputs"],"outputs":["equity_value"],"checks":["bridge_components_traceable"],"conditions":[],"source_references":["damodaran-valuation-class"]},
    {"step_id":"validate-valuation","sequence":8,"stage":"validation","purpose":"Check cash-flow continuity, discounting, terminal-value contribution, bridge completeness and arithmetic integrity.","execution_class":"deterministic","requirement_class":"universal","inputs":["enterprise_value_components","equity_value"],"outputs":["validated_valuation"],"checks":["valuation_checks_pass"],"conditions":[],"source_references":["icaew-financial-modelling-code","fast-standard-02c","damodaran-valuation-class"]},
    {"step_id":"run-valuation-sensitivities","sequence":9,"stage":"scenario_sensitivity","purpose":"Recalculate value across explicit discount-rate, terminal and operating scenarios without changing the accepted base case.","execution_class":"deterministic","requirement_class":"universal","inputs":["validated_valuation","valuation_assumptions"],"outputs":["valuation_sensitivities"],"checks":["base_case_preserved","sensitivity_axes_explicit"],"conditions":[],"source_references":["damodaran-valuation-class"]},
    {"step_id":"prepare-valuation-outputs","sequence":10,"stage":"outputs_kpis","purpose":"Expose enterprise value, equity value and the approved sensitivity and cross-check outputs.","execution_class":"deterministic","requirement_class":"universal","inputs":["validated_valuation","valuation_sensitivities"],"outputs":["valuation_outputs"],"checks":["outputs_trace_to_validated_valuation"],"conditions":[],"source_references":["damodaran-valuation-class"]},
    {"step_id":"prepare-commentary-evidence","sequence":11,"stage":"commentary_evidence","purpose":"Produce structured valuation evidence showing assumptions, sensitivities, value bridges, concentration and limitations for stakeholder commentary.","execution_class":"governed_rule","requirement_class":"universal","inputs":["valuation_outputs"],"outputs":["commentary_evidence"],"checks":["assumptions_distinguished_from_facts","limitations_visible"],"conditions":[],"source_references":["icaew-financial-modelling-code","damodaran-valuation-class"]}
  ],
  "source_references": ["fast-standard-02c","icaew-financial-modelling-code","damodaran-valuation-class"],
  "review_state": "reference_grounded"
}
