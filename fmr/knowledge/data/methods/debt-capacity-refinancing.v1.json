{
  "contract_version": "analyst-workflow-method.v1",
  "method_id": "debt-capacity-refinancing-analyst-method",
  "version": "1.0.0",
  "family_id": "debt_capacity_refinancing",
  "title": "Debt capacity and refinancing analyst method",
  "objective": "Convert operating cash-flow evidence and explicit financing terms into checked debt-service, leverage, liquidity, covenant and refinancing scenarios without making a lending decision.",
  "steps": [
    {"step_id":"define-financing-decision","sequence":1,"stage":"scope_decision","purpose":"Define the financing or refinancing question, horizon, proposed instruments, constraints and required outputs.","execution_class":"judgment","requirement_class":"universal","inputs":[],"outputs":["financing_scope"],"checks":["decision_and_horizon_explicit"],"conditions":[],"source_references":["cfi-debt-capex","icaew-financial-modelling-code"]},
    {"step_id":"load-cash-flow-and-debt-data","sequence":2,"stage":"source_history","purpose":"Load operating cash-flow evidence, opening debt, contractual terms, liquidity and covenant definitions from governed sources.","execution_class":"source","requirement_class":"universal","inputs":["cash_flow_history","debt_schedule","liquidity_position"],"outputs":["financing_inputs"],"checks":["opening_balances_identified","terms_identified"],"conditions":[],"source_references":["cfi-debt-capex","bodmer-project-finance"]},
    {"step_id":"normalize-and-reconcile-financing-data","sequence":3,"stage":"normalize_reconcile","purpose":"Align periods, units, debt balances and cash flows and reconcile opening positions before projection.","execution_class":"deterministic","requirement_class":"universal","inputs":["financing_inputs"],"outputs":["reconciled_financing_inputs"],"checks":["debt_roll_forward_opens","cash_periods_align"],"conditions":[],"source_references":["fast-standard-02c","icaew-financial-modelling-code"]},
    {"step_id":"set-financing-assumptions","sequence":4,"stage":"assumptions_drivers","purpose":"Set explicit interest, repayment, refinancing and covenant assumptions while preserving contractual facts separately.","execution_class":"judgment","requirement_class":"universal","inputs":["reconciled_financing_inputs"],"outputs":["financing_assumptions"],"checks":["contract_terms_separated_from_scenarios"],"conditions":[],"source_references":["cfi-debt-capex","bodmer-project-finance"]},
    {"step_id":"establish-financing-timeline","sequence":5,"stage":"model_structure","purpose":"Create the financing time axis and payment periods required for cash, interest and covenant calculations.","execution_class":"governed_rule","requirement_class":"universal","inputs":["financing_scope","reconciled_financing_inputs"],"outputs":["financing_timeline"],"checks":["payment_periods_consistent"],"conditions":[],"source_references":["bodmer-project-finance","fast-standard-02c"]},
    {"step_id":"build-debt-and-liquidity-schedules","sequence":6,"stage":"supporting_schedules","purpose":"Build debt opening, draw, repayment, interest and closing-balance schedules together with relevant liquidity movements.","execution_class":"deterministic","requirement_class":"universal","inputs":["financing_timeline","financing_assumptions","reconciled_financing_inputs"],"outputs":["debt_schedules"],"checks":["debt_roll_forward_reconciles"],"conditions":[],"source_references":["cfi-debt-capex","bodmer-project-finance"]},
    {"step_id":"calculate-capacity-and-covenants","sequence":7,"stage":"core_model","purpose":"Calculate debt service, leverage, coverage, liquidity and covenant headroom from the approved schedules and definitions.","execution_class":"deterministic","requirement_class":"universal","inputs":["debt_schedules","reconciled_financing_inputs"],"outputs":["debt_capacity_results"],"checks":["metric_definitions_pinned"],"conditions":[],"source_references":["bodmer-project-finance","cfi-debt-capex"]},
    {"step_id":"validate-financing-model","sequence":8,"stage":"validation","purpose":"Require debt balances, cash movements, interest, repayments and defined covenant calculations to reconcile before analysis.","execution_class":"deterministic","requirement_class":"universal","inputs":["debt_schedules","debt_capacity_results"],"outputs":["validated_debt_analysis"],"checks":["debt_checks_pass","liquidity_checks_pass"],"conditions":[],"source_references":["fast-standard-02c","icaew-financial-modelling-code","bodmer-project-finance"]},
    {"step_id":"run-refinancing-scenarios","sequence":9,"stage":"scenario_sensitivity","purpose":"Recalculate approved interest, repayment, maturity and refinancing scenarios and preserve the accepted base terms.","execution_class":"deterministic","requirement_class":"common_default","inputs":["validated_debt_analysis","financing_assumptions"],"outputs":["refinancing_scenarios"],"checks":["base_case_preserved","scenario_terms_explicit"],"conditions":[],"source_references":["cfi-debt-capex","bodmer-project-finance"]},
    {"step_id":"prepare-financing-outputs","sequence":10,"stage":"outputs_kpis","purpose":"Expose debt balances, debt service, leverage, coverage, liquidity and covenant headroom with explicit limitations.","execution_class":"deterministic","requirement_class":"universal","inputs":["validated_debt_analysis","refinancing_scenarios"],"outputs":["financing_outputs"],"checks":["outputs_trace_to_validated_schedules"],"conditions":[],"source_references":["cfi-debt-capex","bodmer-project-finance"]},
    {"step_id":"prepare-commentary-evidence","sequence":11,"stage":"commentary_evidence","purpose":"Produce source-linked financing evidence, scenario effects, covenant headroom and limitations without representing modelled capacity as lender approval.","execution_class":"governed_rule","requirement_class":"universal","inputs":["financing_outputs"],"outputs":["commentary_evidence"],"checks":["lender_approval_not_inferred","contract_and_scenario_terms_distinguished"],"conditions":[],"source_references":["icaew-financial-modelling-code","bodmer-project-finance"]}
  ],
  "source_references": ["fast-standard-02c","icaew-financial-modelling-code","cfi-debt-capex","bodmer-project-finance"],
  "review_state": "reference_grounded"
}
