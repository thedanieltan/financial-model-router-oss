{
  "contract_version": "analyst-workflow-method.v1",
  "method_id": "budget-forecast-analyst-method",
  "version": "1.0.0",
  "family_id": "budget_forecast",
  "title": "Budget and forecast analyst method",
  "objective": "Convert governed actuals and explicit business drivers into a checked forecast, scenarios, variance evidence, and commentary-ready outputs.",
  "steps": [
    {"step_id":"define-planning-decision","sequence":1,"stage":"scope_decision","purpose":"Define the planning decision, horizon, reporting cadence, and scenario set before modelling.","execution_class":"judgment","requirement_class":"universal","inputs":[],"outputs":["planning_scope"],"checks":["decision_and_horizon_explicit"],"conditions":[],"source_references":["cfi-fpa-excel-modelling","fast-standard-02c"]},
    {"step_id":"load-actuals-and-drivers","sequence":2,"stage":"source_history","purpose":"Load historical financial results and the operational series used to explain or forecast them.","execution_class":"source","requirement_class":"universal","inputs":["financial_statement_history","operational_driver_history"],"outputs":["governed_history"],"checks":["periods_and_units_identified"],"conditions":[],"source_references":["cfi-fpa-excel-modelling","cfi-driver-based-forecasting"]},
    {"step_id":"normalize-and-reconcile","sequence":3,"stage":"normalize_reconcile","purpose":"Normalize periods, entities, currencies and mappings, then reconcile the modelling history to governed source totals.","execution_class":"deterministic","requirement_class":"universal","inputs":["governed_history"],"outputs":["reconciled_history"],"checks":["source_totals_reconcile","periods_complete"],"conditions":[],"source_references":["fast-standard-02c","icaew-financial-modelling-code"]},
    {"step_id":"set-and-validate-drivers","sequence":4,"stage":"assumptions_drivers","purpose":"Select explicit operating drivers and assumptions, keeping management judgment separate from sourced facts.","execution_class":"judgment","requirement_class":"universal","inputs":["reconciled_history","operational_driver_history"],"outputs":["forecast_assumptions","driver_set"],"checks":["assumptions_explicit","driver_relationships_reviewed"],"conditions":[],"source_references":["cfi-driver-based-forecasting","fast-standard-02c"]},
    {"step_id":"establish-model-structure","sequence":5,"stage":"model_structure","purpose":"Create the forecast time axis and consistent model structure needed for repeatable updates.","execution_class":"governed_rule","requirement_class":"common_default","inputs":["planning_scope"],"outputs":["forecast_structure"],"checks":["time_axis_consistent"],"conditions":[],"source_references":["cfi-fpa-excel-modelling","fast-standard-02c"]},
    {"step_id":"build-operating-schedules","sequence":6,"stage":"supporting_schedules","purpose":"Project revenue, people costs, operating costs, capex, debt and other material schedules from explicit drivers where applicable.","execution_class":"deterministic","requirement_class":"universal","inputs":["forecast_structure","forecast_assumptions","driver_set","reconciled_history"],"outputs":["forecast_schedules"],"checks":["schedule_roll_forwards_consistent"],"conditions":[],"source_references":["cfi-fpa-excel-modelling","cfi-debt-capex"]},
    {"step_id":"aggregate-forecast","sequence":7,"stage":"core_model","purpose":"Aggregate the supporting schedules into the required forecast statements and liquidity outputs.","execution_class":"deterministic","requirement_class":"universal","inputs":["forecast_schedules"],"outputs":["base_forecast"],"checks":["statement_links_consistent","cash_flow_consistent"],"conditions":[],"source_references":["cfi-fpa-excel-modelling"]},
    {"step_id":"validate-forecast","sequence":8,"stage":"validation","purpose":"Run reconciliation, completeness, sign, roll-forward and reasonableness checks before analysis.","execution_class":"deterministic","requirement_class":"universal","inputs":["base_forecast","reconciled_history"],"outputs":["validated_forecast"],"checks":["all_mandatory_checks_pass"],"conditions":[],"source_references":["fast-standard-02c","icaew-financial-modelling-code"]},
    {"step_id":"run-planning-scenarios","sequence":9,"stage":"scenario_sensitivity","purpose":"Recalculate approved scenarios or sensitivities without overwriting the base assumptions.","execution_class":"deterministic","requirement_class":"common_default","inputs":["validated_forecast","forecast_assumptions"],"outputs":["scenario_results"],"checks":["base_case_preserved","scenario_inputs_explicit"],"conditions":[],"source_references":["cfi-driver-based-forecasting","fast-standard-02c"]},
    {"step_id":"calculate-variance-and-drivers","sequence":10,"stage":"variance_driver_analysis","purpose":"Compare actual, budget and forecast outcomes and quantify material driver contributions where the data supports attribution.","execution_class":"deterministic","requirement_class":"common_default","inputs":["reconciled_history","validated_forecast","driver_set"],"outputs":["variance_evidence"],"checks":["variance_bridge_reconciles"],"conditions":["actual_or_budget_comparison_available"],"source_references":["cfi-fpa-variance-roll-forward","cfi-driver-based-forecasting"]},
    {"step_id":"prepare-management-outputs","sequence":11,"stage":"outputs_kpis","purpose":"Assemble decision-relevant financial outputs, KPIs and scenario comparisons.","execution_class":"deterministic","requirement_class":"universal","inputs":["validated_forecast","scenario_results","variance_evidence"],"outputs":["management_outputs"],"checks":["outputs_trace_to_validated_results"],"conditions":[],"source_references":["cfi-fpa-excel-modelling","cfi-fpa-variance-roll-forward"]},
    {"step_id":"prepare-commentary-evidence","sequence":12,"stage":"commentary_evidence","purpose":"Produce structured, source-linked facts, variances, drivers, materiality and caveats from which stakeholder commentary can be written.","execution_class":"governed_rule","requirement_class":"universal","inputs":["management_outputs","variance_evidence"],"outputs":["commentary_evidence"],"checks":["evidence_traceable","judgment_not_presented_as_fact"],"conditions":[],"source_references":["cfi-fpa-variance-roll-forward","icaew-financial-modelling-code"]}
  ],
  "source_references": ["fast-standard-02c","icaew-financial-modelling-code","cfi-fpa-excel-modelling","cfi-driver-based-forecasting","cfi-debt-capex","cfi-fpa-variance","cfi-fpa-variance-roll-forward"],
  "review_state": "reference_grounded"
}
